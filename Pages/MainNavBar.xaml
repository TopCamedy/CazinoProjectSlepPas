<Page x:Class="CazinoProjectSlepPas.Pages.MainNavBar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CazinoProjectSlepPas.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1366"
      Title="MainNavBar">
    
    <Grid>
        <Grid.Resources>
            <!-- Стиль для кнопок в NavBar -->
            <Style TargetType="Button" x:Key="NavButtonStyle">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Background" Value="#FF42469E"/>
                <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="15 5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    CornerRadius="8" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF5A60C1"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#40000000"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#FF3A408E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Стиль для кнопок вторичного меню (рулетки) -->
            <Style TargetType="Button" x:Key="SecondaryNavButtonStyle" BasedOn="{StaticResource NavButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="20 5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    CornerRadius="5" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#30000000"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#50000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="345*"/>
            <ColumnDefinition Width="210*"/>
            <ColumnDefinition Width="128*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="105"/>
            <!-- Основной NavBar -->
            <RowDefinition Height="50"/>
            <!-- Дополнительная панель с кнопками -->
            <RowDefinition Height="*"/>
            <!-- Основной контент -->
        </Grid.RowDefinitions>

        <!-- Основная навигационная панель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FF181D7A" Grid.ColumnSpan="3" >


            <!-- Информация о пользователе -->
            <StackPanel Orientation="Horizontal" Margin="150 0">
                <Border Background="#FF42469E" CornerRadius="5" Padding="10 5" Margin="0 0 5 0" Height="50" Width="275">
                    <TextBlock Text="{Binding NowBalance, StringFormat='Баланс: {0}$'}" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

        </StackPanel>

        <!-- Пустое пространство для выравнивания кнопок вправо -->
        <StackPanel Margin="0,0,10,0" Orientation="Horizontal" Grid.Column="2">
            <Button Content="Касса" 
                            Style="{StaticResource NavButtonStyle}" 
                            Width="115" Height="50" 
                            Margin="5" 
                            Click="CassaNavBtn"/>
            <Button Content="Профиль" 
                            Style="{StaticResource NavButtonStyle}" 
                            Width="115" Height="50" 
                            Margin="5" 
                            Click="ProfileNavBtn"/>
        </StackPanel>

        <!-- Дополнительная панель с кнопками -->
        <TextBlock Width="400" Grid.Row="1" HorizontalAlignment="Left" Background="#FF0E1158"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1"  Background="#FF0E1158" >
            <Button Content="Главная" 
                Style="{StaticResource SecondaryNavButtonStyle}" 
                Width="165" Height="32" 
                Margin="50,0,10,0" 
                 HorizontalAlignment="Stretch" Click="HomeNavBtn" Cursor="Hand"/>
            
            <Button Content="Минёр" 
                        Style="{StaticResource SecondaryNavButtonStyle}" 
                        Width="165" Height="32" 
                        Margin="10, 0, 10, 0" 
                        Click="Rullet1NavBtn" HorizontalAlignment="Stretch"/>

            <Button Content="Краш" 
                        Style="{StaticResource SecondaryNavButtonStyle}" 
                        Width="165" Height="32" 
                        Margin="10,0" 
                        Click="Rullet2NavBtn"/>

        </StackPanel>


        <!-- Логотип -->

        <Button Grid.Column="0" 
                        Style="{StaticResource NavButtonStyle}" 
                        Width="125" Height="125" 
                        Margin="10,10,0,10" 
                        HorizontalAlignment="Left" 
                        Click="LogoNavBtn" Grid.RowSpan="2">

            <!--Button.Content>
                <TextBlock Text="Лого" FontSize="16" FontWeight="Bold"/>
            </Button.Content-->
            <Image Source="/Img/photo_5375261617052316277_y.jpg" Stretch="Fill" />
        </Button>

        <!-- Основной контент (здесь будут отображаться страницы) -->
        <Frame x:Name="MainContentFrame" Grid.Row="2" NavigationUIVisibility="Hidden" Grid.ColumnSpan="3"/>

    </Grid>
</Page>
