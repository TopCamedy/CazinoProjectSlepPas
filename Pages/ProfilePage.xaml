<Page x:Class="CazinoProjectSlepPas.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CazinoProjectSlepPas.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="768" d:DesignWidth="1366"
      Title="Профиль">

    <Page.Resources>
        <!-- Общие стили (как в CassaPage) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF42469E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Background" Value="#FF2D2D4D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                BorderBrush="#FF6A6A9E"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стили для профиля -->
        <Style TargetType="TextBlock" x:Key="ProfileLabelStyle">
            <Setter Property="Foreground" Value="#FFA0A0C0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ProfileValueStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Анимированная кнопка (как в CassaPage) -->
        <Style x:Key="AnimatedButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4C4C7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="5" Opacity="0.3" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5C5C8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Основной контейнер -->
        <Border CornerRadius="25" 
                Background="#7F4C4C6D" 
                Margin="150,50,150,50"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Аватарка -->
                <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="5"
                        Width="180" Height="180"
                        Background="#FF42469E"
                        CornerRadius="15"
                        VerticalAlignment="Top">
                    <Viewbox>
                        <TextBlock Text="👤" FontSize="100"/>
                    </Viewbox>
                </Border>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="ПРОФИЛЬ"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10"/>

                <!-- Данные пользователя -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Имя пользователя:" Style="{StaticResource ProfileLabelStyle}"/>
                    <Border CornerRadius="8">
                        <TextBlock Text="{Binding Login}" Style="{StaticResource ProfileValueStyle}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="2">
                    <TextBlock Text="Пароль:" Style="{StaticResource ProfileLabelStyle}"/>
                    <Border CornerRadius="8">
                        <TextBlock Text="{Binding Password}" Style="{StaticResource ProfileValueStyle}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Text="Дата рождения:" Style="{StaticResource ProfileLabelStyle}"/>
                    <Border CornerRadius="8">
                        <TextBlock Text="{Binding BirthDate}" Style="{StaticResource ProfileValueStyle}"/>
                    </Border>
                </StackPanel>

                <!-- Кнопка редактирования -->
                <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                        Content="РЕДАКТИРОВАТЬ ПРОФИЛЬ"
                        Style="{StaticResource AnimatedButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="30,10"
                        Width="300"/>

                <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
            Content="Выйти"
            Style="{StaticResource AnimatedButtonStyle}"
            HorizontalAlignment="Center"
            Padding="30,10"
            Width="300" FontSize="20" Click="VihodAccBtn"/>   
            </Grid>
        </Border>
    </Grid>
</Page>