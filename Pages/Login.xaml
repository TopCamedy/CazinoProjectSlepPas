<Page x:Class="CazinoProjectSlepPas.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CazinoProjectSlepPas.Pages"
      mc:Ignorable="d" 
      Title="LoginPage">

    <Grid>
        <Border BorderBrush="#42469E" BorderThickness="1"
                Background="#2A2A4A" CornerRadius="5"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="20" Width="300">
            <StackPanel>
                <TextBlock Text="Вход в систему" 
                       FontSize="20" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       Foreground="White"/>

                <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                    <TextBlock Text="Логин:" FontWeight="SemiBold" Margin="0,0,0,5"
                           Foreground="White"/>
                    <TextBox x:Name="UsernameInput" Height="30" Padding="5"
                         Background="#2A2A4A"
                         Foreground="White"
                         BorderBrush="#42469E"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                    <TextBlock Text="Пароль:" FontWeight="SemiBold" Margin="0,0,0,5"
                           Foreground="White"/>
                    <PasswordBox x:Name="PasswordInput" Height="30" Padding="5"
                             Background="#2A2A4A"
                             Foreground="White"
                             BorderBrush="#42469E"/>
                </StackPanel>

                <Button x:Name="LoginBtn" Content="Войти" 
                    Height="35"
                    Background="#42469E"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,0,10"
                    Click="LoginBtn_Click"/>

                <TextBlock HorizontalAlignment="Center">
                    <Hyperlink x:Name="RegisterLink" 
                           Click="RegisterLink_Click"
                           Foreground="#A6A8D5">
                        Нет аккаунта? Зарегистрироваться
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Page>