<Page x:Class="CazinoProjectSlepPas.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CazinoProjectSlepPas.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <Grid>
        <Border BorderBrush="#42469E" BorderThickness="1"
            Background="#2A2A4A" CornerRadius="5"
            VerticalAlignment="Center" HorizontalAlignment="Center"
            Padding="20" Width="350">

            <StackPanel>
                <TextBlock Text="Регистрация" 
                       FontSize="22" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       Foreground="White"/>

                <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                    <TextBlock Text="Логин:" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"
                           Foreground="White"/>
                    <TextBox x:Name="LoginInput" 
                         Height="30"
                         Padding="5"
                         Background="#2A2A4A"
                         Foreground="White"
                         BorderBrush="#42469E"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                    <TextBlock Text="Дата рождения:" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"
                           Foreground="White">
                        
                        
                    </TextBlock>
                    <DatePicker x:Name="BirthDateInput" 
                            Height="25"
                            Background="#2A2A4A"
                            Foreground="Black"
                            BorderBrush="#42469E"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                    <TextBlock Text="Пароль:" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"
                           Foreground="White"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="PasswordInput" 
                                 Grid.Column="0"
                                 Height="30"
                                 Padding="5"
                                 PasswordChanged="PasswordInput_PasswordChanged"
                                 Background="#2A2A4A"
                                 Foreground="White"
                                 BorderBrush="#42469E"/>

                        <Button x:Name="ShowPasswordBtn" 
                            Grid.Column="1"
                            Content="👁" 
                            Width="30" 
                            Height="30"
                            Margin="5,0,0,0"
                            Click="ShowPasswordBtn_Click"
                            ToolTip="Показать пароль"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,0,0,20">
                    <TextBlock Text="Подтвердите пароль:" 
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"
                           Foreground="White"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="ConfirmPasswordInput" 
                                 Grid.Column="0"
                                 Height="30"
                                 Padding="5"
                                 PasswordChanged="ConfirmPasswordInput_PasswordChanged"
                                 Background="#2A2A4A"
                                 Foreground="White"
                                 BorderBrush="#42469E"/>

                        <Button x:Name="ShowConfirmPasswordBtn" 
                            Grid.Column="1"
                            Content="👁" 
                            Width="30" 
                            Height="30"
                            Margin="5,0,0,0"
                            Click="ShowConfirmPasswordBtn_Click"
                            ToolTip="Показать пароль"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Сложность пароля:" 
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="White"/>
                    <TextBlock x:Name="PasswordStrengthText" 
                           Margin="5,0,0,0"
                           Foreground="#A6A8D5"/>
                </StackPanel>

                <Button x:Name="RegisterBtn" Content="Зарегистрироваться" 
                    Height="40"
                    Background="#42469E"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="RegisterBtn_Click"
                    Cursor="Hand"/>

                <TextBlock x:Name="ErrorMessage"
                       Foreground="#FF6B6B"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Visibility="Collapsed"/>

                <TextBlock Margin="0,15,0,0" HorizontalAlignment="Center">
                    <Hyperlink x:Name="LoginLink" 
                           Click="LoginLink_Click"
                           Foreground="#A6A8D5">
                        Уже есть аккаунт? Войти
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Page>